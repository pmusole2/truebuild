{
    "cli": {
        "appVersionSource": "remote"
    },
    "build": {
        "production": {
            "autoIncrement": true,
            "distribution": "store",
            "channel": "production",
            "environment": "production",
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://truebuild-suhsi.sevalla.app",
                "EXPO_PUBLIC_PROVIDER_MODE": "meta",
                "EXPO_PUBLIC_GENERATIVE_UI": "steps"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6829728246",
                "ascApiKeyPath": "${EXPO_ASC_API_KEY_PATH}",
                "ascApiKeyId": "${EXPO_ASC_KEY_ID}",
                "ascApiKeyIssuerId": "${EXPO_ASC_ISSUER_ID}"
            }
        }
    }
}
