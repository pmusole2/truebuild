#!/bin/sh
# TrueBuild pre-commit guard. Fails closed: a missing tool, missing or unsafe config,
# private or ignored indexed path, unreadable index entry, scanner error or secret
# finding blocks the commit. It checks the whole index (everything the commit will
# record), not the working tree. Blob bytes come from git's object store and are
# scanned as plain files, so .gitattributes filters, textconv, binary detection and
# NUL bytes cannot hide content.
# Enable once per clone:  git config --local core.hooksPath .githooks
# Local only. `git commit --no-verify` or changing core.hooksPath skips this hook.
set -eu

fail() {
  printf 'pre-commit: BLOCKED. %s\n' "$1" >&2
  exit 1
}

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a git work tree."
cd "$ROOT"

# Hooks started from GUI apps often lack Homebrew on PATH.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
export PATH

command -v python3 >/dev/null 2>&1 || fail "python3 is required for the path guard."
python3 -I -c 'import tomllib' >/dev/null 2>&1 || fail "Python 3.11 or later is required to validate the indexed scan configuration."
command -v gitleaks >/dev/null 2>&1 || fail "gitleaks is not installed (brew install gitleaks). Scanning is unavailable, so the commit is blocked."
[ ! -e .gitleaksignore ] || fail ".gitleaksignore is present. Ignore files are not allowed in this repo; remove it."

TMP=$(mktemp -d "${TMPDIR:-/tmp}/truebuild-precommit.XXXXXX") || fail "cannot create a temp directory."
trap 'rm -rf "$TMP"' EXIT
trap 'exit 1' INT TERM HUP

# 1. Index guard and materialization. Private names and paths matched by git's ignore
#    rules block the commit. Every other index entry is copied, byte for byte from the
#    object store, into a private temp tree. Each entry gets its own directory named by
#    entry number, so repository paths are never used as filesystem paths. Symlinks are
#    written as plain files holding their target text, never followed. Submodules
#    (gitlinks) carry no blob here and are skipped.
if ! python3 -I - "$TMP" <<'PY'
import json
import os
import re
import subprocess
import sys
import tomllib
import unicodedata

TMP = sys.argv[1]
BLOBS = os.path.join(TMP, "blobs")
POLICY = os.path.join(TMP, "ignore-policy")

ENV_TEMPLATES = {".env.example", ".env.sample", ".env.template"}
PRIVATE_DOCUMENT_STEMS = {
    "meta-hackathon-application",
    "meta-hackathon-paste-ready",
}
PRIVATE_DIRS = {".local", ".private", ".aws", "uploads", "provider-responses", "provider_responses", "logs"}
PRIVATE_NAMES = {
    ".netrc", ".npmrc", ".pypirc", "key.properties", "keystore.properties", "credentials.json",
    "googleservice-info.plist", "google-services.json",
}
KEY_SUFFIXES = (".pem", ".key", ".p8", ".p12", ".pfx", ".jks", ".keystore", ".ppk", ".crt", ".cer", ".der",
                ".mobileprovision", ".provisionprofile")
ARCHIVE_SUFFIXES = (".tar", ".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".zip", ".7z",
                    ".rar", ".gz", ".xz", ".bz2")
MEDIA_SUFFIXES = (".mov", ".mp4", ".m4v", ".avi", ".mkv", ".webm", ".heic", ".heif", ".jpg", ".jpeg",
                  ".png", ".gif", ".webp", ".bmp", ".tif", ".tiff", ".dng", ".raw")
CAPTURE_SUFFIXES = (".pdf", ".m4a", ".mp3", ".wav", ".aac", ".caf", ".aiff", ".flac", ".ogg", ".3gp", ".amr")
APP_BINARY_SUFFIXES = (".apk", ".aab", ".ipa", ".xcarchive")
DATA_SUFFIXES = (".json", ".yaml", ".yml", ".toml", ".ini", ".plist", ".txt")
DOTENV = re.compile(r"^\.env(\..+)?$")
SSH_KEY = re.compile(r"^id_(rsa|dsa|ecdsa|ed25519)(\..*)?$")
CREDENTIAL_NAME = re.compile(r"(service[-_]?account|credential|client[-_]?secret|secret)")
DOCUMENT_DIRS = {"doc", "docs", "plan", "plans", "planning", "spec", "specs", "specifications"}
DOCUMENT_SUFFIXES = (".md", ".mdx", ".markdown", ".rst", ".adoc")
DOCUMENT_DATA_SUFFIXES = (
    ".txt", ".json", ".yaml", ".yml", ".toml", ".html", ".htm", ".xml", ".ini",
    ".docx", ".doc", ".rtf", ".odt", ".pages", ".pptx", ".ppt", ".odp",
    ".csv", ".tsv", ".xlsx", ".xls", ".ods", ".numbers", ".keynote",
)
PLANNING_NAME = re.compile(
    r"(?:^|[._ -])(?:plans?|planning|specs?|specifications?|requirements?|prd|adr|rfc|architecture|design)(?:[._ -]|$)"
)
BLOB_MODES = {b"100644", b"100664", b"100755", b"120000"}
GITLINK_MODE = b"160000"


def reason(path):
    # NFKC also maps compatibility spellings such as fullwidth extensions before matching.
    norm = unicodedata.normalize("NFKC", path).casefold()
    parts = norm.split("/")
    low = parts[-1]
    if any(low == stem or low.startswith(stem + ".") for stem in PRIVATE_DOCUMENT_STEMS):
        return "personal application document"
    if low == ".gitleaksignore":
        return "gitleaks ignore file"
    if (DOTENV.match(low) and low not in ENV_TEMPLATES) or low.endswith((".env", ".envrc")):
        return "dotenv file"
    if low in PRIVATE_NAMES or SSH_KEY.match(low) or low.endswith(KEY_SUFFIXES):
        return "credential, key or signing file"
    if CREDENTIAL_NAME.search(low) and low.endswith(DATA_SUFFIXES):
        return "credential-like data file"
    if low.endswith(ARCHIVE_SUFFIXES + APP_BINARY_SUFFIXES) or low.endswith(".log") or ".log." in low:
        return "archive, log or app binary"
    if low.endswith(MEDIA_SUFFIXES):
        return "raw media"
    if low.endswith(CAPTURE_SUFFIXES):
        return "raw manual or audio capture"
    if any(part in PRIVATE_DIRS for part in parts[:-1]):
        return "private, log or upload directory"
    # The exception is the literal root path only; normalization must not admit
    # extra README aliases. Allowed documentation still receives the secret scan.
    if path != "README.md" and (
        low == "readme" or low.startswith("readme.")
        or low.endswith(DOCUMENT_SUFFIXES)
        or any(part in DOCUMENT_DIRS for part in parts[:-1])
        or (low.endswith(DOCUMENT_DATA_SUFFIXES) and PLANNING_NAME.search(low))
    ):
        return "documentation policy: only root README.md is publishable; no planning/specification documents"
    return None


def git(*args):
    # --no-replace-objects: replace refs must not change the bytes that are scanned.
    return subprocess.run(
        ["git", "--no-replace-objects", *args], check=True, capture_output=True,
        env=dict(os.environ, GIT_NO_LAZY_FETCH="1"),
    ).stdout


def index_entries():
    entries = []
    for record in git("ls-files", "-s", "-z").split(b"\0"):
        if not record:
            continue
        meta, sep, raw = record.partition(b"\t")
        mode, sha, stage = meta.split(b" ")
        if not sep or stage != b"0":
            raise ValueError("malformed or unresolved index record")
        entries.append((mode, sha, raw))
    return entries


def gitignored(raw_paths):
    # Read repository ignore files from the staged policy tree. Unstaged edits must
    # not weaken the rules being committed. Local/global excludes still add protection.
    if not raw_paths:
        return set()
    proc = subprocess.run(
        ["git", "--work-tree=" + POLICY, "check-ignore", "--no-index", "-z", "--stdin"],
        input=b"".join(raw + b"\0" for raw in raw_paths),
        capture_output=True,
    )
    if proc.returncode == 1:
        return set()
    if proc.returncode != 0:
        raise RuntimeError(f"check-ignore exited {proc.returncode}")
    return {raw for raw in proc.stdout.split(b"\0") if raw}


def read_blob(reader, sha):
    reader.stdin.write(sha + b"\n")
    reader.stdin.flush()
    fields = reader.stdout.readline().split()
    if len(fields) != 3 or fields[0] != sha or fields[1] != b"blob":
        raise ValueError("object missing or not a blob")
    size = int(fields[2])
    data = reader.stdout.read(size)
    if len(data) != size or reader.stdout.read(1) != b"\n":
        raise ValueError("short read from object store")
    return data


def write_file(target, data):
    os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)


def safe_parts(raw):
    parts = raw.split(b"/")
    if raw.startswith(b"/") or any(part in (b"", b".", b"..") for part in parts):
        raise ValueError("unsafe index path")
    return parts


def prepare_policy(entries):
    os.makedirs(POLICY, mode=0o700, exist_ok=True)
    config = None
    for mode, sha, raw in entries:
        if raw == b".gitleaks.toml" or raw.split(b"/")[-1] == b".gitignore":
            if mode not in {b"100644", b"100755"}:
                raise ValueError("policy must be a regular indexed file")
            data = git("cat-file", "blob", sha.decode("ascii"))
            if raw == b".gitleaks.toml":
                config = data
            else:
                write_file(os.path.join(os.fsencode(POLICY), *safe_parts(raw)), data)
    if config is None:
        raise ValueError("stage .gitleaks.toml before committing")
    parsed = tomllib.loads(config.decode("utf-8"))
    if parsed.get("extend") != {"useDefault": True}:
        print("BLOCKED indexed scan configuration: built-in rules must remain enabled.")
        raise ValueError("indexed scan configuration must extend built-in rules only")
    rules = parsed.get("rules", [])
    if not isinstance(rules, list) or any(
        not isinstance(rule, dict)
        or not isinstance(rule.get("id"), str)
        or not rule["id"].startswith("truebuild-")
        for rule in rules
    ):
        print("BLOCKED indexed scan configuration: custom rule IDs must use the truebuild- prefix.")
        raise ValueError("custom rule ID namespace required")

    def has_override(value):
        if isinstance(value, dict):
            return any(
                key.casefold() in {"allowlist", "allowlists", "path"} or has_override(item)
                for key, item in value.items()
            )
        return isinstance(value, list) and any(has_override(item) for item in value)

    if has_override(parsed):
        raise ValueError("indexed scan configuration contains an override")
    write_file(os.path.join(TMP, "scan-config.toml"), config)


def write_blob(number, raw, data):
    parts = safe_parts(raw)
    base = os.path.join(os.fsencode(BLOBS), str(number).encode())
    # Gitleaks' built-in path allowlist skips names such as .svg, .pdf, .bin, node_modules/
    # and lock files, so the content is also written under a neutral name it never skips.
    # The named copy keeps the real path for the built-in path rules.
    write_file(os.path.join(base, b"content.txt"), data)
    write_file(os.path.join(base, b"named", *parts), data)


def main():
    entries = index_entries()
    prepare_policy(entries)
    blocked = {}
    for mode, _sha, raw in entries:
        if raw == b"README.md" and mode not in {b"100644", b"100664", b"100755"}:
            blocked.setdefault(raw, "documentation policy: root README.md must be a regular file")
        why = reason(raw.decode("utf-8", "surrogateescape"))
        if why:
            blocked.setdefault(raw, why)
    for raw in gitignored([raw for _mode, _sha, raw in entries]):
        blocked.setdefault(raw, "matches a .gitignore rule")
    if blocked:
        for raw, why in blocked.items():
            print(f"BLOCKED indexed path ({why}): {raw.decode('utf-8', 'surrogateescape')!a}")
        print("Unstage with: git rm --cached -- <path>. Ignore rules and git add -f do not override this check.")
        return 1

    os.makedirs(BLOBS, mode=0o700, exist_ok=True)
    mapping = {}
    reader = subprocess.Popen(
        ["git", "--no-replace-objects", "cat-file", "--batch"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        env=dict(os.environ, GIT_NO_LAZY_FETCH="1"),
    )
    try:
        for number, (mode, sha, raw) in enumerate(entries):
            if mode == GITLINK_MODE:
                continue
            if mode not in BLOB_MODES:
                raise ValueError(f"unsupported index mode {mode.decode('ascii', 'replace')}")
            write_blob(number, raw, read_blob(reader, sha))
            mapping[str(number)] = raw.decode("utf-8", "surrogateescape")
    finally:
        reader.stdin.close()
        if reader.wait() != 0:
            raise RuntimeError("cat-file failed")
    with open(os.path.join(TMP, "paths.json"), "w", encoding="utf-8") as handle:
        json.dump(mapping, handle)
    return 0


try:
    sys.exit(main())
except Exception as exc:  # no traceback: it could echo file content in some failures
    print(f"BLOCKED indexed content could not be read safely ({type(exc).__name__}).")
    sys.exit(1)
PY
then
  fail "indexed path(s) are blocked or unreadable. Nothing was committed."
fi

# 2. Secret scan of every materialized blob. Output goes to a private temp file; only
#    rule, file and line are printed. Redaction is full and gitleaks:allow markers are ignored.
set +e
gitleaks dir "$TMP/blobs" \
  --config "$TMP/scan-config.toml" \
  --gitleaks-ignore-path "$TMP" \
  --ignore-gitleaks-allow \
  --redact=100 \
  --no-banner --no-color --log-level error \
  --exit-code 1 \
  --report-format json --report-path "$TMP/findings.json" \
  >"$TMP/scan.log" 2>&1
RC=$?
set -e

case "$RC" in
  0) ;;
  1)
    python3 -I - "$TMP" "$TMP/findings.json" <<'PY' || true
import json
import os
import sys

tmp, report_path = sys.argv[1], sys.argv[2]
with open(os.path.join(tmp, "paths.json"), encoding="utf-8") as handle:
    paths = json.load(handle)
with open(report_path, encoding="utf-8") as report:
    findings = json.load(report) or []
# Each blob is scanned twice (content and named copies), so the same hit can repeat.
lines = set()
for item in findings:
    number = os.path.relpath(item.get("File", ""), os.path.join(tmp, "blobs")).split(os.sep)[0]
    lines.add(f"  rule={item.get('RuleID', '?')} file={paths.get(number, '?')!a} line={item.get('StartLine', '?')}")
for line in sorted(lines):
    print(line)
print(f"gitleaks found {len(lines)} secret(s) in the index. Values are not shown. Remove them, use a placeholder or a local .env, then re-add.")
sys.exit(1)
PY
    fail "secret finding(s) in the index. Nothing was committed."
    ;;
  *) fail "gitleaks could not complete the scan (exit $RC). Nothing was committed." ;;
esac

exit 0
