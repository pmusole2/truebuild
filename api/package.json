        "smoke": "tsx scripts/smoke.ts"
    },
    "dependencies": {
        "@meta-sam/parser": "0.1.0",
        "@truebuild/contracts": "0.1.0",
        "sharp": "0.35.5",
        "zod": "4.6.7",
        "hono": "4.13.14",
        "@hono/node-server": "2.1.5",
        "tsx": "4.23.15"
    },
    "type": "module"
}
