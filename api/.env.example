# Real provider is the default; no request falls back to fixtures without a key.
PROVIDER_MODE=meta
MODEL_API_KEY=
# Live checks and asks are always Standard Spark. Contributor IDs are rejected.
MODEL_SPARK=muse-spark-1.3
# Manual parsing: Standard Spark default, or explicit muse-wonder-1.0. No model fallback.
MODEL_PARSE=muse-spark-1.3
# Empty disables separate one-use follow-ups; Standard Spark/Wonder only.
MODEL_SECOND_OPINION=
# Follow-ups have a separate 60s deadline, 120s ticket TTL, and one upstream attempt.
MODEL_SAM=sam-3.1
# Full manual context by default. Explicit compact fallback requires all cited facts within 1-2 pages.
MODEL_CHECK_CONTEXT=full
# Optional, default off. MODEL_LAYOUT=1 makes the same single check/ask request also propose a compact step layout and
# grounded next-part/target regions: ids and 0-1000 grid boxes only, at most 3 components of 3 ids (48 characters each),
# layout JSON at most 600 UTF-8 bytes, each region at most 192 bytes; an over-budget, out-of-range or invalid proposal is
# dropped (never clamped) and the verdict is unchanged. Real model adequacy/latency under this budget is not verified.
# Unset, empty or 0 keeps the request (schema, prompt, 1500-token cap) and public response exactly as before.
MODEL_LAYOUT=
# Optional, default off, requires MODEL_LAYOUT=1. 1 lets a Wonder second opinion author layout/regions as well.
MODEL_LAYOUT_WONDER=
# Required on data/session routes, including fixtures. For local demos only, use truebuild-fixture-demo.
API_SHARED_SECRET=
PORT=3001
MODEL_CALL_LIMIT_PER_DAY=1500
MODEL_CALL_LIMIT_PER_CLIENT_DAY=200
PARSE_LIMIT_PER_HOUR=3
# This bounds provider attempts, including retries. It is not a dollar balance.
# Check and question absolute deadline in integer milliseconds: 1 through 8000 (provider cap).
CHECK_TIMEOUT_MS=8000
# Comma-separated exact browser origins, added to the two local Expo defaults.
CORS_ORIGINS=

# /api/session returns a process UUID and expiresAt=Number.MAX_SAFE_INTEGER (metadata only).
