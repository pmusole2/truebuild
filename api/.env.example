# Meta is the default. Fixture is an explicit test/offline server mode and never a content-type fallback.
PROVIDER_MODE=meta
MODEL_API_KEY=
MODEL_SPARK=muse-spark-1.3
MODEL_SAM=sam-3.1
# Explicit server-only alternatives: muse-spark-1.3-contributor (content may train models),
# or muse-wonder-1.0 (preview, higher token cost). Neither is chosen automatically.
# Required on data/session routes, including fixtures. Keep server/shared transport config separate from Meta's key.
API_SHARED_SECRET=
PORT=3001
# Process-local ATTEMPT count, including status retries and SAM. Failures are never refunded.
# This is not a dollar budget. Pricing/token assumptions print from the explicitly invoked doctor.
MODEL_CALL_LIMIT=200
# Absolute check/question deadline includes multipart reads, normalization, dispatch, backoff and response body.
CHECK_TIMEOUT_MS=8000
# Default full reviewed plan/parts and all ordered manual pages; no automatic timeout fallback.
# Explicit compact fallback sends only 1-2 pages when they cover ALL current-step citations.
MODEL_CHECK_CONTEXT=full
CORS_ORIGINS=
# Parse supports 1-20 pages within 8 MiB aggregate image bytes, 4 MiB/image.
# Full check/ask: up to 20 manual pages + observation, still within the same 8 MiB aggregate budget.
# Compact >2 required pages returns cannot_verify/missing evidence without provider dispatch.
# Parse output cap 24000 tokens includes reasoning; truncated/incomplete output is rejected.
# /api/session adds providerMode, sparkModel, samModel and checkContext; configured means key present, not access verified.
