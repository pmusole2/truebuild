# Default fixture mode never accesses MODEL_API_KEY or dispatches outbound model requests.
PROVIDER_MODE=fixture
MODEL_API_KEY=
# Required on data/session routes, including fixtures. For local demos only, use truebuild-fixture-demo.
API_SHARED_SECRET=
PORT=3001
MODEL_CALL_LIMIT=200
# Check and question absolute deadline in integer milliseconds: 1 through 8000 (provider cap).
CHECK_TIMEOUT_MS=8000
# Comma-separated exact browser origins, added to the two local Expo defaults.
CORS_ORIGINS=

# /api/session returns a process UUID and expiresAt=Number.MAX_SAFE_INTEGER (metadata only).
